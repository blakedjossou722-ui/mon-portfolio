---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
const siteBase = Astro.site ? Astro.site.pathname.replace(/\/$/, '') : '';
---

<Layout
  title="À propos | Blake DJOSSOU - Développeur Web & Designer"
  description="Découvrez le parcours de Blake DJOSSOU, développeur web full-stack et designer graphique spécialisé dans les expériences numériques performantes."
>
  <Header />
  <main id="main" class="flex-grow">
    <Hero
      eyebrow="// À PROPOS"
      title="Blake DJOSSOU — Coder et designer sans compromis."
      text="Je fais deux choses qui se croisent : je code des sites web performants et je crée des identités visuelles fortes. La synergie idéale entre technique et esthétique."
      imageSrc={`${siteBase}/Responsive.png`}
      imageAlt="Illustration responsive moderne"
      primaryHref={`${siteBase}/projects`}
      secondaryHref={`${siteBase}/contact`}
    />

    <!-- Section Intro -->
    <section class="py-16 relative">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block">
          Synergie & Compétences
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-white tracking-tight leading-snug mb-6">
          Deux univers qui s'enrichissent mutuellement
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto">
          Je suis développeur JavaScript/TypeScript et designer graphique. Quand je code, je pense expérience utilisateur et élégance visuelle. Quand je design, je pense architecture, performance et intégration technique.
        </p>
      </div>
    </section>

    <!-- Section Codeur -->
    <section class="py-16 border-t border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block font-mono">
            // PÔLE DÉVELOPPEMENT
          </span>
          <h2 class="text-3xl font-extrabold font-heading text-white tracking-tight">
            Le code, mon langage principal
          </h2>
          <p class="text-slate-400 text-sm mt-2">
            Spécialisé dans les interfaces web modernes, l'accessibilité WCAG et l'architecture scalable.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <!-- Frontend -->
          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal reveal-delay-1">
            <h3 class="text-indigo-400 font-heading font-bold text-lg mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
              Frontend
            </h3>
            <div class="flex flex-wrap gap-2">
              {['JavaScript', 'TypeScript', 'React', 'Astro', 'Tailwind CSS', 'Next.js', 'HTML5/CSS3'].map((tech) => (
                <span class="px-2.5 py-1 text-xs font-mono font-medium bg-indigo-500/10 text-indigo-300 rounded-md border border-indigo-500/20">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Backend -->
          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal reveal-delay-2">
            <h3 class="text-purple-400 font-heading font-bold text-lg mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
              Backend & Data
            </h3>
            <div class="flex flex-wrap gap-2">
              {['Node.js', 'Express', 'REST APIs', 'GraphQL', 'MongoDB', 'PostgreSQL', 'Firebase'].map((tech) => (
                <span class="px-2.5 py-1 text-xs font-mono font-medium bg-purple-500/10 text-purple-300 rounded-md border border-purple-500/20">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- DevOps -->
          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal reveal-delay-3">
            <h3 class="text-emerald-400 font-heading font-bold text-lg mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              DevOps & Outillage
            </h3>
            <div class="flex flex-wrap gap-2">
              {['Git', 'GitHub', 'VS Code', 'Docker', 'Vercel', 'Netlify', 'npm/pnpm'].map((tech) => (
                <span class="px-2.5 py-1 text-xs font-mono font-medium bg-emerald-500/10 text-emerald-300 rounded-md border border-emerald-500/20">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section Designer -->
    <section class="py-16 border-t border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-purple-400 mb-2 inline-block font-mono">
            // PÔLE CREATIVE DESIGN
          </span>
          <h2 class="text-3xl font-extrabold font-heading text-white tracking-tight">
            Le design visuel & l'UX
          </h2>
          <p class="text-slate-400 text-sm mt-2">
            Branding, direction artistique et maquettage Figma orientés expérience utilisateur.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal">
            <h3 class="text-white font-bold text-lg mb-4">Logiciels de Création</h3>
            <div class="flex flex-wrap gap-2">
              {['Figma', 'Photoshop', 'Illustrator', 'Canva Pro', 'Blender', 'Affinity Designer', 'Procreate'].map((tool) => (
                <span class="px-3 py-1 text-xs font-medium bg-slate-900 text-slate-300 rounded-lg border border-slate-800">
                  {tool}
                </span>
              ))}
            </div>
          </div>

          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal reveal-delay-1">
            <h3 class="text-white font-bold text-lg mb-4">Spécialités Design</h3>
            <div class="flex flex-wrap gap-2">
              {['UI/UX Design', 'Branding & Logo', 'Affiches Print & Web', 'Typographie', 'Théorie des Couleurs', 'Motion Graphics'].map((spec) => (
                <span class="px-3 py-1 text-xs font-medium bg-slate-900 text-slate-300 rounded-lg border border-slate-800">
                  {spec}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section Philosophie -->
    <section class="py-16 border-t border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block font-mono">
            // PHILOSOPHIE DE TRAVAIL
          </span>
          <h2 class="text-3xl font-extrabold font-heading text-white tracking-tight">
            Comment je conçois chaque projet
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center mb-4 font-bold">1</div>
            <h3 class="font-bold text-white mb-2">Intention</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Chaque ligne de code et chaque pixel répondent à un objectif précis.</p>
          </div>

          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal reveal-delay-1">
            <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center mb-4 font-bold">2</div>
            <h3 class="font-bold text-white mb-2">Vitesse & Vitals</h3>
            <p class="text-xs text-slate-400 leading-relaxed">La vitesse est une fonctionnalité essentielle pour la conversion.</p>
          </div>

          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal reveal-delay-2">
            <div class="w-10 h-10 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center mb-4 font-bold">3</div>
            <h3 class="font-bold text-white mb-2">Curiosité Tech</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Veille permanente pour appliquer les meilleures pratiques modernes.</p>
          </div>

          <div class="glass-card p-6 rounded-2xl border border-white/10 reveal reveal-delay-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4 font-bold">4</div>
            <h3 class="font-bold text-white mb-2">Écoute & Conseil</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Accompagnement transparent pour transformer vos idées en réalité.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
        <div class="glass-card p-8 sm:p-12 rounded-3xl border border-indigo-500/30 bg-gradient-to-br from-indigo-950/40 via-slate-950 to-slate-950">
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-white mb-3">
            Prêt à concrétiser votre prochain projet ?
          </h2>
          <p class="text-slate-400 text-sm max-w-xl mx-auto mb-6">
            Développement web, refonte UI/UX ou création visuelle : discutons ensemble de vos besoins.
          </p>
          <a
            href={`${siteBase}/contact`}
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold text-sm shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 transition-all hover:-translate-y-0.5"
          >
            <span>Discuter de mon projet</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
