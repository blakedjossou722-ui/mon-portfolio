---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
---

<Layout
  title="Services & Compétences | Blake DJOSSOU"
  description="Découvrez les prestations proposées par Blake DJOSSOU : développement web (Astro, React, Node.js), design graphique (Figma, Photoshop, Branding) et optimisation de performance SEO."
>
  <Header />
  <main id="main" class="flex-grow">
    <Hero
      eyebrow="// SERVICES & EXPERTISE"
      title="Ce que je peux réaliser pour vous."
      text="Des prestations sur-mesure combinant intégration web ultra-rapide, design visuel percutant et expérience utilisateur fluide pour maximiser l'impact de vos projets."
      imageSrc="/Web.png"
      imageAlt="Illustration services web"
      primaryLabel="Voir mes projets"
      primaryHref="/projects"
      secondaryLabel="Demander un devis"
      secondaryHref="/contact"
    />

    <!-- Main Services Grid -->
    <section class="py-16 border-t border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block font-mono">
            // TROIS PÔLES D'EXPERTISE
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-white tracking-tight">
            Des offres adaptées à vos objectifs
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Card 1 -->
          <div class="glass-card glass-card-hover rounded-2xl p-8 border border-white/10 flex flex-col justify-between reveal">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 mb-6">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold font-heading text-white mb-3">Développement Web</h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-6">
                Création de sites web réactifs, rapides et sécurisés avec Astro, React et Node.js. Intégration soignée et SEO sémantique.
              </p>
            </div>
            <div class="pt-4 border-t border-slate-800 flex flex-wrap gap-1.5">
              {['Astro', 'React', 'TypeScript', 'Node.js', 'REST API'].map(tag => (
                <span class="px-2.5 py-1 text-xs font-mono font-medium bg-slate-900 text-slate-300 rounded-md border border-slate-800">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Card 2 -->
          <div class="glass-card glass-card-hover rounded-2xl p-8 border border-white/10 flex flex-col justify-between reveal reveal-delay-1">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-400 mb-6">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold font-heading text-white mb-3">Design Visuel & Branding</h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-6">
                Conception d'identités graphiques, logos uniques, affiches et supports marketing sur-mesure avec Photoshop & Illustrator.
              </p>
            </div>
            <div class="pt-4 border-t border-slate-800 flex flex-wrap gap-1.5">
              {['Figma', 'Photoshop', 'Illustrator', 'Branding', 'Print'].map(tag => (
                <span class="px-2.5 py-1 text-xs font-mono font-medium bg-slate-900 text-slate-300 rounded-md border border-slate-800">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Card 3 -->
          <div class="glass-card glass-card-hover rounded-2xl p-8 border border-white/10 flex flex-col justify-between reveal reveal-delay-2">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-6">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold font-heading text-white mb-3">UX/UI & Accessibilité</h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-6">
                Parcours utilisateurs fluides, optimisation des temps de chargement (Core Web Vitals) et conformité aux normes WCAG.
              </p>
            </div>
            <div class="pt-4 border-t border-slate-800 flex flex-wrap gap-1.5">
              {['Core Web Vitals', 'WCAG (A11y)', 'UI/UX', 'Responsive'].map(tag => (
                <span class="px-2.5 py-1 text-xs font-mono font-medium bg-slate-900 text-slate-300 rounded-md border border-slate-800">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stack Gallery -->
    <section class="py-16 border-t border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block font-mono">
            // OUTILS & ENVIRONNEMENT
          </span>
          <h2 class="text-3xl font-extrabold font-heading text-white tracking-tight">
            Les technologies au quotidien
          </h2>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 reveal">
          {[
            { name: 'React', img: '/React.png' },
            { name: 'TypeScript', img: '/TypeScript.png' },
            { name: 'Tailwind CSS', img: '/tailwind.png' },
            { name: 'Node.js', img: '/Node.js.png' },
            { name: 'HTML5', img: '/html5.png' },
            { name: 'CSS', img: '/CSS.png' },
            { name: 'JavaScript', img: '/JavaScript.png' },
            { name: 'Laravel', img: '/Laravel.png' },
            { name: 'PHP', img: '/PHP.png' },
            { name: 'Python', img: '/Python.png' },
            { name: 'Java', img: '/Java.png' },
            { name: 'C++', img: '/C++.png' },
            { name: 'MongoDB', img: '/MongoDB.png' },
            { name: 'PostgreSQL', img: '/PostgreSQL.png' },
            { name: 'MySQL', img: '/mysql.png' },
            { name: 'Firebase', img: '/Firebase.png' },
            { name: 'Supabase', img: '/Supabase.png' },
            { name: 'Figma', img: '/Figma.png' },
            { name: 'Photoshop', img: '/Photoshop.png' },
            { name: 'Illustrator', img: '/Illustrator.png' },
            { name: 'Canva', img: '/Canva.png' },
            { name: 'Blender', img: '/Blender.png' },
            { name: 'Affinity Designer', img: '/Affinity_Designer.png' },
            { name: 'Procreate', img: '/Procreate.png' },
            { name: 'Git', img: '/Git.png' },
            { name: 'GitHub', img: '/GitHub.png' },
            { name: 'Docker', img: '/Docker.png' },
            { name: 'VS Code', img: '/vscode.png' },
            { name: 'Vercel', img: '/Vercel.png' },
            { name: 'GraphQL', img: '/GraphQL.png' },
            { name: 'REST APIs', img: '/rest-apis.png' },
          ].map((tool) => (
            <div class="tool-card glass-card p-4 rounded-xl border border-white/10 flex items-center gap-3">
              <ResponsiveImage src={tool.img} alt={tool.name} width={32} height={32} class="w-8 h-8 object-contain shrink-0" />
              <span class="text-xs font-semibold text-slate-200 truncate">{tool.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
        <div class="glass-card p-8 sm:p-12 rounded-3xl border border-indigo-500/30">
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-white mb-3">
            Besoin d'une prestation personnalisée ?
          </h2>
          <p class="text-slate-400 text-sm max-w-xl mx-auto mb-6">
            Parlons de vos besoins et établissons ensemble une stratégie de réalisation efficace.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold text-sm shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 transition-all hover:-translate-y-0.5"
          >
            <span>Me contacter</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .tool-card {
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .tool-card:hover {
    transform: translateY(-6px) scale(1.03);
    border-color: rgba(129, 140, 248, .65);
    box-shadow: 0 14px 30px -12px rgba(129, 140, 248, .7);
  }
</style>
