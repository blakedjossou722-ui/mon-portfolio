---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';

const mainProjects = [
  {
    title: 'Xcms Architecture',
    category: 'Architecture Web',
    desc: 'Une infrastructure web compacte et scalable. Design system complet avec composants réutilisables.',
    href: '/projects/xcms',
    image: '/Dev_icone.png'
  },
  {
    title: 'Quest-API',
    category: 'Backend & REST APIs',
    desc: 'Une API RESTful hyper-performante avec documentation interactive et SDKs multi-langages.',
    href: '/projects/quest-api',
    image: '/rest-apis.png'
  },
  {
    title: 'The Manifesto Of Modernism',
    category: 'Design & Direction Artistique',
    desc: 'Une campagne éditoriale graphique : affiches, mise en page typographique et direction artistique.',
    href: '/projects/manifesto',
    image: '/Illustrator.png'
  },
  {
    title: 'Synapse UI',
    category: 'UI/UX & Composants',
    desc: 'Bibliothèque de composants React accessibles, thématisés et hautement performants.',
    href: '/projects/synapse-ui',
    image: '/React.png'
  }
];

const graphicProjects = [
  { title: 'Affiches', href: '/projects/affiches', desc: 'Campagnes éditoriales et visuels grand format.' },
  { title: 'Cartes de visite', href: '/projects/cartes-visite', desc: 'Identités professionnelles imprimables haut de gamme.' },
  { title: 'Flyers', href: '/projects/flyers', desc: 'Supports print & digitaux événementiels.' },
  { title: 'Logos', href: '/projects/logos', desc: 'Identités visuelles fortes et sur-mesure.' }
];
---

<Layout
  title="Projets & Réalisations | Blake DJOSSOU"
  description="Découvrez l'ensemble des projets de développement web et créations graphiques réalisés par Blake DJOSSOU (Astro, React, Node.js, Figma, Photoshop)."
>
  <Header />
  <main id="main" class="flex-grow">
    <Hero
      eyebrow="// PORTFOLIO & RÉALISATIONS"
      title="Des projets concrets qui fonctionnent vraiment."
      text="Sélection de réalisations couvrant le développement web, le design d'interfaces et la création visuelle. À chaque fois, la rencontre entre rigueur technique et esthétique."
      imageSrc="/Professional.gif"
      imageAlt="Illustration réalisations"
      primaryLabel="Me contacter"
      primaryHref="/contact"
    />

    <!-- Main Web Projects Section -->
    <section class="py-16 border-t border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block font-mono">
            // PROJETS WEB & ARCHITECTURES
          </span>
          <h2 class="text-3xl font-extrabold font-heading text-white tracking-tight">
            Développement & Applications
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {mainProjects.map((proj, idx) => (
            <article class={`glass-card glass-card-hover rounded-2xl overflow-hidden border border-white/10 flex flex-col justify-between reveal reveal-delay-${(idx % 2) + 1}`}>
              <div class="p-6 sm:p-8 flex items-start justify-between gap-4">
                <div>
                  <span class="text-xs font-mono font-semibold text-indigo-400 uppercase tracking-wider block mb-2">{proj.category}</span>
                  <h3 class="text-xl font-bold font-heading text-white mb-3">{proj.title}</h3>
                  <p class="text-slate-400 text-sm leading-relaxed mb-6">{proj.desc}</p>
                </div>
                <div class="w-14 h-14 rounded-xl bg-slate-900 border border-slate-800 p-2 shrink-0 flex items-center justify-center">
                  <ResponsiveImage src={proj.image} alt={proj.title} width={40} height={40} class="w-full h-full object-contain" />
                </div>
              </div>
              <div class="px-6 sm:px-8 pb-6 pt-0 border-t border-slate-800/80 mt-auto">
                <a href={proj.href} class="inline-flex items-center gap-2 text-xs font-bold font-mono text-indigo-400 hover:text-indigo-300 pt-4">
                  <span>Voir le projet en détail</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Graphic Design Categories -->
    <section class="py-16 border-t border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-purple-400 mb-2 inline-block font-mono">
            // DESIGN & CRÉATION VISUELLE
          </span>
          <h2 class="text-3xl font-extrabold font-heading text-white tracking-tight">
            Catégories Graphiques
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {graphicProjects.map((gProj) => (
            <div class="glass-card glass-card-hover p-6 rounded-2xl border border-white/10 flex flex-col justify-between reveal">
              <div>
                <h3 class="font-bold text-white text-lg mb-2">{gProj.title}</h3>
                <p class="text-slate-400 text-xs leading-relaxed mb-4">{gProj.desc}</p>
              </div>
              <a href={gProj.href} class="text-xs font-bold font-mono text-purple-400 hover:text-purple-300 inline-flex items-center gap-1">
                <span>Découvrir</span> →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
