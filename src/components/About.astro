---
const stats = [
  { value: '12', label: 'Projets réalisés', desc: 'Web & création visuelle', suffix: '+' },
  { value: '30', label: 'Technologies maîtrisées', desc: 'Code, data & design', suffix: '+' },
  { value: '2', label: 'Expertises complémentaires', desc: 'Développement & design', suffix: '' },
];
---

<section id="about" class="py-20 relative reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="max-w-3xl mb-12 initial-reveal">
      <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block">
        À propos de moi
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-white tracking-tight leading-snug">
        Développer des solutions créatives, à la fois <span class="text-gradient">techniques</span> et <span class="text-gradient">esthétiques</span>.
      </h2>
    </div>

    <!-- Main Grid -->
    <div class="grid lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Bio Narrative -->
      <div class="lg:col-span-7 glass-card rounded-2xl p-8 border border-white/10 flex flex-col justify-between space-y-6">
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          Développeur web full-stack et designer graphique, je me passionne pour la création d'expériences numériques complètes.
        </p>
        <p class="text-slate-400 text-base leading-relaxed">
          Ma force réside dans la synergie entre deux univers : construire une architecture front-end & back-end solide et performante tout en apportant un soin extrême aux détails visuels, aux typographies et à l'expérience utilisateur.
        </p>

        <div class="pt-4 border-t border-slate-800 flex flex-wrap gap-4 items-center">
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
            <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Apprentissage continu & veille techno
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Pratique des standards du web (WCAG, SEO)
          </div>
        </div>
      </div>

      <!-- Stat Cards -->
      <div class="lg:col-span-5 grid sm:grid-cols-1 gap-4">
        {stats.map((stat) => (
          <div class="glass-card glass-card-hover rounded-2xl p-6 border border-white/10 flex items-center gap-5">
            <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-indigo-500/20 to-purple-500/20 border border-indigo-500/30 flex items-center justify-center font-heading font-extrabold text-2xl text-indigo-400 shrink-0">
              <span class="stat-count" data-count={stat.value} data-suffix={stat.suffix}>0</span>
            </div>
            <div>
              <h3 class="font-heading font-bold text-lg text-white">{stat.label}</h3>
              <p class="text-xs text-slate-400 mt-0.5">{stat.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const counters = document.querySelectorAll<HTMLElement>('.stat-count');
    const observer = new IntersectionObserver((entries, instance) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const counter = entry.target as HTMLElement;
        const target = Number(counter.dataset.count || 0);
        const suffix = counter.dataset.suffix || '';
        const startedAt = performance.now();
        const duration = 700;
        const update = (now: number) => {
          const progress = Math.min((now - startedAt) / duration, 1);
          counter.textContent = `${Math.round(target * progress)}${suffix}`;
          if (progress < 1) requestAnimationFrame(update);
        };
        requestAnimationFrame(update);
        instance.unobserve(counter);
      });
    }, { threshold: 0.5 });
    counters.forEach((counter) => observer.observe(counter));
  });
</script>
