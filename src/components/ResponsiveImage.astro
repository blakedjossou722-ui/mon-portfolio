---
export interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
}
const {
  src,
  alt = '',
  width,
  height,
  class: cls = '',
  loading = 'lazy',
  sizes = '100vw',
  fetchpriority = 'auto'
} = Astro.props as Props;

const siteBase = Astro.site ? Astro.site.pathname.replace(/\/$/, '') : '';
const resolveSrc = (input: string) => {
  if (!input) return input;
  if (input.startsWith(siteBase)) return input;
  return input.startsWith('/') ? `${siteBase}${input}` : input;
};
const avif = resolveSrc(src.replace(/\.(png|jpe?g|gif)$/i, '.avif'));
const webp = resolveSrc(src.replace(/\.(png|jpe?g|gif)$/i, '.webp'));
const srcAttr = resolveSrc(src);
---

<picture>
  <source srcset={avif} type="image/avif" />
  <source srcset={webp} type="image/webp" />
  <img
    src={srcAttr}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    sizes={sizes}
    class={cls}
    width={width}
    height={height}
  />
</picture>
