---
const services = [
  {
    title: 'Développement Web Front & Back',
    desc: 'Création d’applications web modernes, réactives et rapides avec Astro, React, TypeScript et Node.js. Intégration soignée et propre.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />`,
    tags: ['Astro', 'React', 'Tailwind CSS', 'Node.js', 'REST API'],
    badgeColor: 'from-indigo-500 to-blue-500'
  },
  {
    title: 'Design Graphique & UI/UX',
    desc: 'Conception de maquettes interactives sur Figma, création d’identités visuelles, d’affiches publicitaires et de supports de communication impactants.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
    tags: ['Figma', 'Photoshop', 'UI/UX Design', 'Branding', 'Affiches'],
    badgeColor: 'from-purple-500 to-pink-500'
  },
  {
    title: 'Optimisation, SEO & Accessibilité',
    desc: 'Amélioration de la vitesse de chargement (Core Web Vitals), référencement naturel et respect des normes d’accessibilité (A11y / WCAG).',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
    tags: ['LCP / CWV', 'SEO Sémantique', 'A11y (WCAG)', 'Responsive'],
    badgeColor: 'from-emerald-500 to-teal-500'
  }
];
---

<section id="services" class="py-20 relative reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block">Mes Domaines d'Expertise</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-white tracking-tight">Ce que je peux <span class="text-gradient">apporter</span> à vos projets</h2>
      <p class="text-slate-400 text-base mt-3">Des prestations sur-mesure allant du design à l'intégration technique.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="glass-card glass-card-hover rounded-2xl p-8 flex flex-col justify-between relative group overflow-hidden">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-indigo-400 mb-6 group-hover:scale-110 group-hover:border-indigo-500/50 transition-all">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={service.icon}></svg>
            </div>
            <h3 class="text-xl font-bold font-heading text-white mb-3 group-hover:text-indigo-300 transition-colors">{service.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">{service.desc}</p>
          </div>
          <div class="pt-4 border-t border-slate-800/80 flex flex-wrap gap-1.5">
            {service.tags.map((tag) => (
              <span class="px-2.5 py-1 text-xs font-medium bg-slate-900/90 text-slate-300 rounded-md border border-slate-800">{tag}</span>
            ))}
          </div>
          <div class={`absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r ${service.badgeColor} opacity-0 group-hover:opacity-100 transition-opacity`}></div>
        </div>
      ))}
    </div>
  </div>
</section>
