---
import ResponsiveImage from './ResponsiveImage.astro';

const siteBase = Astro.site ? Astro.site.pathname.replace(/\/$/, '') : '';

const projects = [
  {
    title: 'Xcms Architecture',
    category: 'Architecture Web & Design System',
    desc: 'Infrastructure web compacte et scalable. Design system complet avec composants React/Astro réutilisables et documentation. ',
    tags: ['Astro', 'React', 'TypeScript', 'Tailwind'],
    link: '/projects/xcms',
    image: '/Dev_icone.png',
    badgeColor: 'border-indigo-500/30 text-indigo-300'
  },
  {
    title: 'Quest-API RESTful',
    category: 'Backend & SDKs Multi-langages',
    desc: 'API RESTful haute performance avec documentation interactive Swagger/OpenAPI et SDKs pour JavaScript, Python et PHP.',
    tags: ['Node.js', 'Express', 'TypeScript', 'REST API'],
    link: '/projects/quest-api',
    image: '/rest-apis.png',
    badgeColor: 'border-purple-500/30 text-purple-300'
  },
  {
    title: 'The Manifesto Of Modernism',
    category: 'Design Visuel & Direction Artistique',
    desc: 'Campagne éditoriale graphique : affiches publicitaires, mise en page typographique et charte de marque.',
    tags: ['Photoshop', 'Illustrator', 'Branding', 'Print'],
    link: '/projects/manifesto',
    image: '/Illustrator.png',
    badgeColor: 'border-pink-500/30 text-pink-300'
  },
  {
    title: 'Synapse UI Component Library',
    category: 'UI/UX & Composants Reutilisables',
    desc: 'Bibliothèque de composants React accessibles et thématisés avec documentation d’intégration complète.',
    tags: ['React', 'Tailwind CSS', 'Storybook', 'A11y'],
    link: '/projects/synapse-ui',
    image: '/React.png',
    badgeColor: 'border-cyan-500/30 text-cyan-300'
  }
];

const resolveHref = (href: string) => href.startsWith('/') ? `${siteBase}${href}` : href;
---

<section id="projects" class="py-16 border-t border-slate-800/80 reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Heading -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6 reveal">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2 inline-block font-mono">
          // RÉALISATIONS RÉCENTES
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-white tracking-tight">
          Sélection de mes <span class="text-gradient">projets phares</span>
        </h2>
      </div>
      <a
        href={`${siteBase}/projects`}
        class="inline-flex items-center gap-2 text-xs font-bold font-mono text-indigo-400 hover:text-indigo-300 transition-colors"
      >
        <span>Tous les projets</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {projects.map((project, index) => (
        <article class={`glass-card glass-card-hover rounded-2xl overflow-hidden border border-white/10 flex flex-col justify-between group reveal reveal-delay-${(index % 3) + 1}`}>
          <div>
            <!-- Banner / Thumbnail Header -->
            <div class="h-44 bg-slate-900/90 border-b border-slate-800 p-6 flex items-center justify-between relative overflow-hidden">
              <div class="z-10 flex flex-col gap-2">
                <span class={`px-3 py-1 text-xs font-mono font-semibold bg-slate-950/80 rounded-full border ${project.badgeColor}`}>
                  {project.category}
                </span>
                <h3 class="font-heading font-bold text-xl text-white group-hover:text-indigo-300 transition-colors">
                  {project.title}
                </h3>
              </div>

              <div class="w-16 h-16 rounded-xl bg-slate-800/80 border border-slate-700 p-2 shrink-0 z-10 flex items-center justify-center">
                <ResponsiveImage src={project.image} alt={project.title} width={48} height={48} class="w-full h-full object-contain" />
              </div>

              <!-- Ambient Glow in Card -->
              <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-indigo-500/10 rounded-full blur-xl group-hover:bg-indigo-500/20 transition-all"></div>
            </div>

            <!-- Description & Tech Badges -->
            <div class="p-6">
              <p class="text-slate-400 text-sm leading-relaxed mb-6">
                {project.desc}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-2">
                {project.tags.map((tag) => (
                  <span class="px-2.5 py-1 text-xs font-mono font-medium bg-slate-900 text-slate-300 rounded-md border border-slate-800">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Card Footer -->
          <div class="p-6 pt-0">
            <a
              href={resolveHref(project.link)}
              class="inline-flex items-center gap-2 text-xs font-bold font-mono text-indigo-400 hover:text-indigo-300 transition-colors"
            >
              <span>Découvrir le projet</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
