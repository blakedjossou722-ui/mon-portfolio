---
const currentYear = new Date().getFullYear();
const siteBase = Astro.site ? Astro.site.pathname.replace(/\/$/, '') : '';
const resolveHref = (href: string) => {
  if (!href) return href;
  if (href.startsWith(siteBase)) return href;
  return href.startsWith('/') ? `${siteBase}${href}` : href;
};

const footerNav = [
  { href: '/', label: 'Accueil' },
  { href: '/about', label: 'À propos' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projets' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="border-t border-slate-800/80 bg-slate-950/95 py-8 relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-slate-400">
    
    <!-- Brand Info -->
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-600 to-purple-500 flex items-center justify-center text-white font-bold font-heading text-xs shadow-md">
        P
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-slate-200 font-heading">Blake DJOSSOU</span>
        <span class="text-slate-500 font-mono text-[11px]">&copy; {currentYear} • Tous droits réservés.</span>
      </div>
    </div>

    <!-- Links -->
    <nav class="flex flex-wrap items-center gap-6 font-mono text-xs" aria-label="Navigation de pied de page">
      {footerNav.map((link) => (
        <a href={resolveHref(link.href)} class="hover:text-white transition-colors">
          {link.label}
        </a>
      ))}
    </nav>

  </div>
</footer>