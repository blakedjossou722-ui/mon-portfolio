---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Portfolio | Développeur Web & Designer Graphique",
  description = "Portfolio professionnel d'un étudiant en 3e année de développement web et design graphique. Découvrez mes projets, compétences et créations visuelles."
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen selection:bg-indigo-500 selection:text-white antialiased relative overflow-x-hidden">
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 pointer-events-none z-0 glow-gradient"></div>
    <div class="fixed top-1/4 -left-48 w-96 h-96 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="fixed bottom-1/3 -right-48 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
